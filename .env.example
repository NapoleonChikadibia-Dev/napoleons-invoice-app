SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=you@gmail.com
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=replace-with-your-google-app-password
# Where your app lives, used for links in emails. Leave empty for local testing.
APP_BASE_URL=

# ---- Security ----
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-64-random-characters

# Set to "production" on the live server only. It makes the app refuse to
# start without a real SECRET_KEY and sends login cookies over HTTPS only.
APP_ENV=

# Set to 1 only when behind a proxy that sets X-Forwarded-For
# (PythonAnywhere, Render, Railway). Leave empty on your laptop.
TRUST_PROXY=
